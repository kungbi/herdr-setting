# Deny by default. Only reviewed, portable files below may be tracked.
/*
!/.gitignore
!/README.md
!/herdr/
!/plugins/

/herdr/*
!/herdr/config.toml
!/herdr/plugins.txt

/plugins/*
!/plugins/agent-picker/
/plugins/agent-picker/*
!/plugins/agent-picker/.gitignore
!/plugins/agent-picker/LICENSE
!/plugins/agent-picker/README.md
!/plugins/agent-picker/agent-picker.py
!/plugins/agent-picker/agent_completion_times.py
!/plugins/agent-picker/check_dependencies.py
!/plugins/agent-picker/herdr-plugin.toml
!/plugins/agent-picker/run
!/plugins/agent-picker/tests/
/plugins/agent-picker/tests/*
!/plugins/agent-picker/tests/test_completion_times.py
!/plugins/agent-picker/tests/test_date_sections.py
!/plugins/agent-picker/tests/test_live_picker.py
!/plugins/agent-picker/tests/test_picker.py

# Defense in depth: keep these excluded even if an allowlist grows later.
**/.env
**/.env.*
**/*.env
**/env
**/*credential*
**/*secret*
**/*token*
**/auth.json
**/hosts.yml
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/sessions/
**/workspaces/
**/state/
**/completions/
**/agent-completions/
**/logs/
**/*.log
**/*.sock
**/*.pid
**/*.bak
**/*.backup*
**/*.before-*
**/__pycache__/
**/*.py[cod]
**/dist/
**/node_modules/
**/.venv/
**/venv/
**/.DS_Store
