# Deny by default. Only reviewed, portable files below may be tracked.
/*
!/.gitignore
!/README.md
!/herdr/

/herdr/*
!/herdr/config.toml
!/herdr/plugins.txt

# Defense in depth: keep these excluded even if an allowlist grows later.
**/.env
**/.env.*
**/*.env
**/env
**/*credential*
**/*secret*
**/*token*
**/auth.json
**/hosts.yml
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/sessions/
**/workspaces/
**/state/
**/completions/
**/agent-completions/
**/logs/
**/*.log
**/*.sock
**/*.pid
**/*.bak
**/*.backup*
**/*.before-*
**/__pycache__/
**/*.py[cod]
**/dist/
**/node_modules/
**/.venv/
**/venv/
**/.DS_Store
